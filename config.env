# Non-secret runtime defaults, sourced into the pod env by run_pod.sh / smoke_agent.sh.
# (Secrets like RUNPOD_API_KEY / SSH_KEY_PATH live in .env, gitignored.)
# The model is NOT set here — run_pod.sh derives it from the chosen configs/<model>.yaml.
BASE_URL=http://localhost:8000
MAX_TOKENS=512

# Claude Code -> LiteLLM proxy (Anthropic API) -> vLLM
ANTHROPIC_BASE_URL=http://localhost:4000
ANTHROPIC_AUTH_TOKEN=sk-dev-lab
ANTHROPIC_MODEL=dev-model

# Concurrency sweep + SLO. The knee is the max concurrency whose median stream meets both.
CONCURRENCY=1,2,4,8,16,32
SLO_MAX_TTFT=2.0
SLO_MIN_TPS=20.0

# Hardware metadata labels (GPU/CPU/RAM are auto-detected; these just annotate the run).
HW_PROVIDER=RunPod
HW_INSTANCE=
HW_USD_PER_HOUR=
