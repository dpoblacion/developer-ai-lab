# Non-secret runtime defaults, sourced into the pod env by run_pod.sh / smoke_agent.sh.
# (Secrets like RUNPOD_API_KEY / SSH_KEY_PATH live in .env, gitignored.)
# Sweep levels / SLO thresholds live in the benchmark scenario def (benchmarks/*/scenario.yaml).
# Hardware price lives in the hardware config (configs/hardware/*.yaml).
BASE_URL=http://localhost:8000

# Claude Code -> LiteLLM proxy (Anthropic API) -> vLLM
ANTHROPIC_BASE_URL=http://localhost:4000
ANTHROPIC_AUTH_TOKEN=sk-dev-lab
ANTHROPIC_MODEL=dev-model
