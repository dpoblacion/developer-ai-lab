# vLLM endpoint (model server) and served model name. run_pod.sh overrides MODEL
# from the chosen config's served_model_name.
BASE_URL=http://localhost:8000
MODEL=qwen3-coder-30b-fp8
MAX_TOKENS=512

# Claude Code -> LiteLLM proxy (Anthropic API) -> vLLM
ANTHROPIC_BASE_URL=http://localhost:4000
ANTHROPIC_AUTH_TOKEN=sk-dev-lab
ANTHROPIC_MODEL=dev-model

# Concurrency sweep + SLO. The knee is the max concurrency whose median stream meets both.
CONCURRENCY=1,2,4,8,16,32
SLO_MAX_TTFT=2.0
SLO_MIN_TPS=20.0

# Hardware metadata labels (GPU/CPU/RAM are auto-detected; these just annotate the run).
HW_PROVIDER=RunPod
HW_INSTANCE=
HW_USD_PER_HOUR=
