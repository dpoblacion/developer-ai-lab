# Local secrets for the RunPod orchestrator. Copy to .env (gitignored) and fill in.
# .env is loaded by scripts/run_benchmark.py; real env vars take precedence.

RUNPOD_API_KEY=
# Path to a passphrase-less private SSH key (<path>.pub must exist). No RunPod-account
# registration needed: the orchestrator injects the .pub into each pod at boot (PUBLIC_KEY env).
SSH_KEY_PATH=
# Optional but recommended: a free Hugging Face read token (huggingface.co/settings/tokens).
# Authenticates model downloads on the pod, raising the Hub rate limit from anonymous
# (3k resolver req/5min per IP) to 5k per-account — avoids 429 download stalls on big models.
HF_TOKEN=
